{
  "manifest_version": 3,
  "name": "Extrator de Dados de Imóveis SP",
  "description": "Extraia dados completos de imóveis em São Paulo inserindo apenas o endereço",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "imoveis_sp_popup_html.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "imoveis_sp_background_js.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}