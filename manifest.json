{
  "manifest_version": 3,
  "name": "Extrator de Dados de Imóveis (SP e Curitiba)",
  "description": "Extraia dados completos de imóveis em São Paulo e Curitiba inserindo apenas o endereço",
  "version": "2.3",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}